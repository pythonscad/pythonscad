{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "description":
        "Review all submodule updates weekly; never merge native dependency changes automatically.",
      "matchManagers": [
        "git-submodules"
      ],
      "schedule": [
        "before 6am on monday"
      ],
      "labels": [
        "dependencies",
        "build"
      ],
      "assignees": [
        "nomike"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "git-submodules"
      ],
      "matchDepNames": [
        "submodules/OpenCSG"
      ],
      "versioning": "regex:^opencsg-(?<major>\\d+)-(?<minor>\\d+)-(?<patch>\\d+)-release$"
    },
    {
      "matchManagers": [
        "git-submodules"
      ],
      "matchDepNames": [
        "submodules/Clipper2"
      ],
      "versioning": "regex:^Clipper2_(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description":
        "Only advance release-tagged dependencies to newer versions, never repin an existing tag (Clipper2 currently includes post-release fixes).",
      "matchManagers": [
        "git-submodules"
      ],
      "matchDepNames": [
        "submodules/mimalloc",
        "submodules/manifold",
        "submodules/OpenCSG",
        "submodules/Clipper2"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the vcpkg release tag used by Windows PyPI wheel builds.",
      "managerFilePatterns": [
        "/^scripts\\/cibuildwheel\\/install-deps-windows\\.ps1$/"
      ],
      "matchStrings": [
        "\\$VcpkgVersion = \"(?<currentValue>\\d{4}\\.\\d{2}\\.\\d{2})\"\\s+\\$VcpkgBaseline = \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "autoReplaceStringTemplate":
        "$VcpkgVersion = \"{{{newValue}}}\"\n$VcpkgBaseline = \"{{{newDigest}}}\"",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "microsoft/vcpkg",
      "versioningTemplate": "loose"
    }
  ]
}
